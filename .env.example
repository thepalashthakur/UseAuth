# Supabase project > Connect. Use a publishable key, never a secret/service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Generate a private 32-byte hex secret for short-lived password recovery grants.
RECOVERY_GRANT_SECRET=replace-with-64-random-hex-characters
# Canonical public origin; no trailing slash. Required for confirmation and recovery emails.
APP_URL=http://localhost:3000
# Exact comma-separated consuming-app origins allowed for token API CORS and recovery return URLs.
AUTH_ALLOWED_ORIGINS=http://localhost:3001
# Fixed mobile return links. Use HTTPS Universal Links/App Links or an app URL scheme.
# Register the auth-service /auth/mobile/confirm/ios and /android URLs in Supabase Redirect URLs.
IOS_APP_REDIRECT_URL=https://ios.example.com/auth/confirmed
ANDROID_APP_REDIRECT_URL=https://android.example.com/auth/confirmed
# SSO pilot. Leave unset until Supabase OAuth Server and the MyHabits client are configured.
SSO_MYHABITS_CLIENT_ID=
SSO_MYHABITS_REDIRECT_URI=https://myhabits-dun.vercel.app/auth/sso/callback
